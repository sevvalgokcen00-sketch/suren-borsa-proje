# Bu dosya commit EDILIR. Gercek degerleri .env.local icine yazin.
#
# Backend API'sinin taban adresi.
#   yerel  : http://localhost:5000
#   uretim : https://<cloud-run-servis-adresi>
#
# UYARI: NEXT_PUBLIC_ onekli degiskenler BUILD ZAMANINDA JavaScript paketine
# gomulur ve siteyi acan herkes tarafindan okunabilir. Buraya ASLA gizli deger
# (Turso token'i, JWT secret, API anahtari) koymayin. Frontend bunlarin
# hicbirine ihtiyac duymaz.
NEXT_PUBLIC_API_URL=
